# Backend environment. Copy to .env and fill in real values.
# NEVER commit .env — it is git-ignored.

# Required
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
BASE_URL=http://localhost:8080

# Optional (defaults shown)
PORT=8080
APP_ENV=development            # development | test | production
STATIC_DIR=                    # frontend/dist in production; empty = API only
ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false            # true by default in production
TRUSTED_PROXIES=               # comma-separated CIDRs allowed to set X-Forwarded-For
SESSION_TTL_HOURS=720
LOG_LEVEL=info
DB_MAX_CONNS=10
CLICK_FLUSH_INTERVAL=5s
CACHE_SIZE=10000
CACHE_TTL=60s
CACHE_NEG_TTL=10s
MAX_URLS_PER_USER=1000
BLOCKED_HOSTS=

# Rate limits (requests per minute, burst)
RATE_REDIRECT_PER_MINUTE=240
RATE_REDIRECT_BURST=60
RATE_CREATE_ANON_PER_MINUTE=10
RATE_CREATE_ANON_BURST=5
RATE_CREATE_USER_PER_MINUTE=30
RATE_CREATE_USER_BURST=10
RATE_LOGIN_PER_MINUTE=10
RATE_LOGIN_BURST=10
RATE_LOGIN_FAIL_PER_MINUTE=5
RATE_LOGIN_FAIL_BURST=5
RATE_REGISTER_PER_MINUTE=10
RATE_REGISTER_BURST=10
RATE_API_PER_MINUTE=120
RATE_API_BURST=120
